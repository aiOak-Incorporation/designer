# ---------- Upload Design ----------
class DesignForm(forms.ModelForm):
    class Meta:
        model = Design
        fields = ["title", "season", "year", "cover_image", "description", "published"]

class TechpackForm(forms.ModelForm):
    class Meta:
        model = Techpack
        fields = ["fabric", "trims", "measurements", "bom_file", "notes"]

@login_required
def upload_design(request):
    if request.method == "POST":
        d_form = DesignForm(request.POST, request.FILES)
        t_form = TechpackForm(request.POST, request.FILES)
        if d_form.is_valid() and t_form.is_valid():
            design = d_form.save(commit=False)
            design.created_by = request.user
            design.save()

            techpack = t_form.save(commit=False)
            techpack.design = design
            techpack.save()

            messages.success(request, "Design & Techpack uploaded successfully.")
            return redirect("design_list")
        else:
            messages.error(request, "Please correct the errors below.")
    else:
        d_form = DesignForm()
        t_form = TechpackForm()
    return render(request, "redym_portfolio/upload_design.html", {"design_form": d_form, "techpack_form": t_form})

# ---------- Signup ----------
def signup_view(request):
    if request.method == "POST":
        form = DesignerSignUpForm(request.POST)
        if form.is_valid():
            user = form.save(commit=False)
            user.is_active = False
            user.save()

            # Create user subscription with free trial
            from datetime import timedelta
            from django.utils import timezone
            from .models import UserSubscription, SubscriptionPlan

            # Calculate trial end date (7 days from now)
            trial_end_date = timezone.now() + timedelta(days=7)
            
            # Get selected subscription plan and payment method
            subscription_plan = form.cleaned_data.get('subscription_plan')
            payment_method = form.cleaned_data.get('payment_method')
            
            # Create user subscription
            user_subscription = UserSubscription.objects.create(
                user=user,
                plan=subscription_plan,
                status='free_trial',
                payment_method=payment_method,
                trial_end_date=trial_end_date,
                auto_renewal=True
            )

            # Enhanced admin notification email
            plan_info = f"Selected Plan: {subscription_plan.display_name} (${subscription_plan.price})" if subscription_plan else "Free Trial Only"
            payment_info = f"Payment Method: {payment_method}" if payment_method else "No payment method selected"
            
            send_mail(
                subject="🎨 New Designer Signup - Approval Required | REDYM",
                message=f"""
A new designer has signed up for REDYM and is awaiting approval:

Designer Details:
• Username: {user.username}
• Email: {user.email}
• Registration Date: {user.date_joined.strftime('%B %d, %Y at %I:%M %p')}
• {plan_info}
• {payment_info}
• Trial End Date: {trial_end_date.strftime('%B %d, %Y at %I:%M %p')}

Please review and approve this designer account in the admin panel:
{request.build_absolute_uri('/admin/pending-designers/')}

Best regards,
REDYM Platform
                """.strip(),
                from_email=settings.DEFAULT_FROM_EMAIL,
                recipient_list=[settings.ADMIN_EMAIL],
                fail_silently=True,
            )

            # Success message based on plan selection
            if subscription_plan:
                success_message = f"🎉 Welcome to REDYM! Your 7-day free trial has started. After the trial, you'll be subscribed to {subscription_plan.display_name} (${subscription_plan.price})."
            else:
                success_message = "🎉 Welcome to REDYM! Your 7-day free trial has started. You can choose a subscription plan anytime before your trial ends."
            
            messages.success(request, success_message)
            return redirect("login")
    else:
        form = DesignerSignUpForm()
    
    # Add subscription plans to context
    from .models import SubscriptionPlan
    context = {
        "form": form,
        "subscription_plans": SubscriptionPlan.objects.filter(is_active=True).order_by('price')
    }
    return render(request, "registration/signup.html", context)

# ---------- Designer Dashboard ----------
class DesignerDashboardView(LoginRequiredMixin, TemplateView):
    template_name = "redym_portfolio/dashboard.html"
    
    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        user = self.request.user
        
        # Get user's designs (filter by designer relationship when available)
        user_designs = Design.objects.filter(designer=user).order_by('-created_at')[:5] if hasattr(user, 'designs') else Design.objects.filter(published=True).order_by('-created_at')[:5]
        
        context.update({
            'recent_designs': user_designs,
            'current_section': 'dashboard',
        })
        return context

@login_required
def designer_designs_view(request):
    """View all designs for the logged-in designer"""
    designs = Design.objects.filter(designer=request.user) if hasattr(request.user, 'designs') else Design.objects.filter(published=True)
    
    # Get available years for filter
    available_years = designs.values_list('year', flat=True).distinct().order_by('-year')
    
    context = {
        'designs': designs.order_by('-created_at'),
        'available_years': available_years,
        'current_section': 'designs',
    }
    return render(request, 'redym_portfolio/designer_designs.html', context)

@login_required
def designer_design_create_view(request):
    """Create a new design with comprehensive form"""
    if request.method == 'POST':
        # Basic design information
        title = request.POST.get('title')
        description = request.POST.get('description', '')
        season = request.POST.get('season')
        year = request.POST.get('year', 2025)
        category = request.POST.get('category', '')
        target_market = request.POST.get('target_market', '')
        
        # Design specifications
        fabric_type = request.POST.get('fabric_type', '')
        fabric_weight = request.POST.get('fabric_weight', '')
        color_palette = request.POST.get('color_palette', '')
        target_price = request.POST.get('target_price')
        size_range = request.POST.get('size_range', '')
        
        # Technical details
        technical_notes = request.POST.get('technical_notes', '')
        has_techpack = request.POST.get('has_techpack') == 'true'
        
        # Publishing options
        published = request.POST.get('published') == 'true'
        featured = request.POST.get('featured') == 'true'
        
        # Files
        cover_image = request.FILES.get('cover_image')
        techpack_file = request.FILES.get('techpack_file')
        
        try:
            design = Design.objects.create(
                title=title,
                description=description,
                season=season,
                year=int(year),
                category=category,
                target_market=target_market,
                fabric_type=fabric_type,
                fabric_weight=fabric_weight,
                color_palette=color_palette,
                target_price=float(target_price) if target_price else None,
                size_range=size_range,
                technical_notes=technical_notes,
                has_techpack=has_techpack,
                published=published,
                featured=featured,
                cover_image=cover_image,
                techpack_file=techpack_file,
                designer=request.user
            )
            
            messages.success(request, f'🎉 Design "{title}" created successfully!')
            return redirect('designer_designs')
            
        except Exception as e:
            messages.error(request, f'Error creating design: {str(e)}')
    
    context = {
        'current_year': 2025,
        'current_section': 'designs',
    }
    return render(request, 'redym_portfolio/designer_design_create.html', context)

@login_required
def designer_design_edit_view(request, design_id):
    """Edit an existing design"""
    design = get_object_or_404(Design, id=design_id, designer=request.user)
    
    if request.method == 'POST':
        # Update design fields
        design.title = request.POST.get('title', design.title)
        design.description = request.POST.get('description', design.description)
        design.season = request.POST.get('season', design.season)
        design.year = int(request.POST.get('year', design.year))
        design.category = request.POST.get('category', design.category)
        design.target_market = request.POST.get('target_market', design.target_market)
        design.fabric_type = request.POST.get('fabric_type', design.fabric_type)
        design.fabric_weight = request.POST.get('fabric_weight', design.fabric_weight)
        design.color_palette = request.POST.get('color_palette', design.color_palette)
        design.size_range = request.POST.get('size_range', design.size_range)
        design.technical_notes = request.POST.get('technical_notes', design.technical_notes)
        design.has_techpack = request.POST.get('has_techpack') == 'true'
        design.published = request.POST.get('published') == 'true'
        design.featured = request.POST.get('featured') == 'true'
        
        # Handle price
        target_price = request.POST.get('target_price')
        design.target_price = float(target_price) if target_price else None
        
        # Handle file uploads
        if request.FILES.get('cover_image'):
            design.cover_image = request.FILES.get('cover_image')
        
        if request.FILES.get('techpack_file'):
            design.techpack_file = request.FILES.get('techpack_file')
        
        design.save()
        messages.success(request, f'✅ Design "{design.title}" updated successfully!')
        return redirect('designer_designs')
    
    context = {
        'design': design,
        'current_section': 'designs',
    }
    return render(request, 'redym_portfolio/designer_design_edit.html', context)

@login_required
def designer_design_delete_view(request, design_id):
    """Delete a design"""
    design = get_object_or_404(Design, id=design_id, designer=request.user)
    
    if request.method == 'POST':
        design_title = design.title
        design.delete()
        messages.success(request, f'🗑️ Design "{design_title}" deleted successfully!')
        return redirect('designer_designs')
    
    context = {
        'design': design,
        'current_section': 'designs',
    }
    return render(request, 'redym_portfolio/designer_design_confirm_delete.html', context)

@login_required
def designer_design_detail_api(request, design_id):
    """API endpoint for design detail modal"""
    design = get_object_or_404(Design, id=design_id, designer=request.user)
    
    html_content = f"""
    <div class="design-detail-modal">
        <div class="design-header">
            <h3>{design.title}</h3>
            <div class="design-meta">
                <span class="season-year">{design.season} {design.year}</span>
                <span class="category">{design.category or 'Uncategorized'}</span>
            </div>
        </div>
        
        <div class="design-content">
            <div class="design-image-section">
                {'<img src="' + design.cover_image.url + '" alt="' + design.title + '" class="modal-design-image">' if design.cover_image else '<div class="no-image">No image available</div>'}
            </div>
            
            <div class="design-info-section">
                <div class="info-group">
                    <h4>Description</h4>
                    <p>{design.description or 'No description provided.'}</p>
                </div>
                
                <div class="info-grid">
                    <div class="info-item">
                        <label>Target Market:</label>
                        <span>{design.target_market or 'Not specified'}</span>
                    </div>
                    <div class="info-item">
                        <label>Target Price:</label>
                        <span>${design.target_price or 'Not set'}</span>
                    </div>
                    <div class="info-item">
                        <label>Fabric Type:</label>
                        <span>{design.fabric_type or 'Not specified'}</span>
                    </div>
                    <div class="info-item">
                        <label>Size Range:</label>
                        <span>{design.size_range or 'Not specified'}</span>
                    </div>
                </div>
                
                {'<div class="techpack-section"><h4>Tech Pack Available</h4>' + ('<a href="' + design.techpack_file.url + '" download class="download-btn">📄 Download Tech Pack</a>' if design.techpack_file else '<p>Tech pack file not uploaded</p>') + '</div>' if design.has_techpack else ''}
                
                {'<div class="technical-notes"><h4>Technical Notes</h4><p>' + design.technical_notes + '</p></div>' if design.technical_notes else ''}
            </div>
        </div>
        
        <div class="modal-actions">
            <a href="/dashboard/designs/{design.id}/edit/" class="btn btn-secondary">✏️ Edit Design</a>
            <button onclick="closeDesignModal()" class="btn btn-primary">Close</button>
        </div>
    </div>
    """
    
    return JsonResponse({
        'title': design.title,
        'html': html_content
    })

@login_required
def designer_about_me_view(request):
    """Manage designer profile and about me information"""
    from .models import DesignerProfile
    
    # Get or create designer profile
    designer_profile, created = DesignerProfile.objects.get_or_create(user=request.user)
    
    if request.method == 'POST':
        # Update user basic info
        request.user.first_name = request.POST.get('first_name', request.user.first_name)
        request.user.last_name = request.POST.get('last_name', request.user.last_name)
        request.user.email = request.POST.get('email', request.user.email)
        request.user.save()
        
        # Update designer profile
        designer_profile.phone = request.POST.get('phone', designer_profile.phone)
        designer_profile.location = request.POST.get('location', designer_profile.location)
        designer_profile.professional_title = request.POST.get('professional_title', designer_profile.professional_title)
        designer_profile.years_of_experience = request.POST.get('years_of_experience') or None
        designer_profile.bio = request.POST.get('bio', designer_profile.bio)
        designer_profile.specializations = request.POST.get('specializations', designer_profile.specializations)
        designer_profile.education = request.POST.get('education', designer_profile.education)
        designer_profile.website = request.POST.get('website', designer_profile.website)
        designer_profile.portfolio_url = request.POST.get('portfolio_url', designer_profile.portfolio_url)
        designer_profile.instagram = request.POST.get('instagram', designer_profile.instagram)
        designer_profile.linkedin = request.POST.get('linkedin', designer_profile.linkedin)
        designer_profile.pinterest = request.POST.get('pinterest', designer_profile.pinterest)
        designer_profile.other_social = request.POST.get('other_social', designer_profile.other_social)
        designer_profile.preferred_contact_method = request.POST.get('preferred_contact_method', designer_profile.preferred_contact_method)
        designer_profile.available_for_collaboration = request.POST.get('available_for_collaboration') == 'true'
        designer_profile.freelance_work = request.POST.get('freelance_work') == 'true'
        designer_profile.full_time_opportunities = request.POST.get('full_time_opportunities') == 'true'
        designer_profile.consulting = request.POST.get('consulting') == 'true'
        
        # Handle profile image upload
        if request.FILES.get('profile_image'):
            designer_profile.profile_image = request.FILES.get('profile_image')
        
        designer_profile.save()
        
        messages.success(request, '✅ Profile updated successfully!')
        return redirect('designer_about_me')
    
    context = {
        'designer_profile': designer_profile,
        'current_section': 'about',
    }
    return render(request, 'redym_portfolio/designer_about_me.html', context)

@login_required
def designer_contact_view(request):
    """Manage designer contact information and collaboration preferences"""
    from .models import DesignerProfile
    
    designer_profile, created = DesignerProfile.objects.get_or_create(user=request.user)
    
    if request.method == 'POST':
        # Update user email
        request.user.email = request.POST.get('email', request.user.email)
        request.user.save()
        
        # Update contact information
        designer_profile.phone = request.POST.get('phone', designer_profile.phone)
        designer_profile.location = request.POST.get('location', designer_profile.location)
        designer_profile.preferred_contact_method = request.POST.get('preferred_contact_method', designer_profile.preferred_contact_method)
        designer_profile.website = request.POST.get('website', designer_profile.website)
        designer_profile.portfolio_url = request.POST.get('portfolio_url', designer_profile.portfolio_url)
        designer_profile.linkedin = request.POST.get('linkedin', designer_profile.linkedin)
        designer_profile.instagram = request.POST.get('instagram', designer_profile.instagram)
        designer_profile.available_for_collaboration = request.POST.get('available_for_collaboration') == 'true'
        designer_profile.freelance_work = request.POST.get('freelance_work') == 'true'
        designer_profile.full_time_opportunities = request.POST.get('full_time_opportunities') == 'true'
        designer_profile.consulting = request.POST.get('consulting') == 'true'
        designer_profile.partnerships = request.POST.get('partnerships') == 'true'
        designer_profile.collaboration_note = request.POST.get('collaboration_note', designer_profile.collaboration_note)
        designer_profile.response_time = request.POST.get('response_time', designer_profile.response_time)
        designer_profile.working_hours = request.POST.get('working_hours', designer_profile.working_hours)
        
        designer_profile.save()
        
        messages.success(request, '📧 Contact information updated successfully!')
        return redirect('designer_contact')
    
    # Count social links
    social_links_count = sum([
        1 if designer_profile.website else 0,
        1 if designer_profile.portfolio_url else 0,
        1 if designer_profile.linkedin else 0,
        1 if designer_profile.instagram else 0,
        1 if designer_profile.pinterest else 0,
        1 if designer_profile.other_social else 0,
    ])
    
    context = {
        'designer_profile': designer_profile,
        'social_links_count': social_links_count,
        'current_section': 'contact',
    }
    return render(request, 'redym_portfolio/designer_contact.html', context)

# ---------- Designer Approval Flow ----------
@method_decorator([login_required, user_passes_test(lambda u: u.is_staff)], name="dispatch")
class PendingDesignersView(ListView):
    model = User
    template_name = "redym_portfolio/pending_designers.html"
    context_object_name = "pending_designers"

    def get_queryset(self):
        return User.objects.filter(is_active=False).order_by("-date_joined")

@login_required
@user_passes_test(lambda u: u.is_staff)
def approve_designer(request, user_id):
    user = get_object_or_404(User, id=user_id, is_active=False)
    user.is_active = True
    user.save()
    messages.success(request, f"Designer {user.username} has been approved.")
    return redirect("pending_designers")

@login_required
@user_passes_test(lambda u: u.is_staff)
def reject_designer(request, user_id):
    user = get_object_or_404(User, id=user_id, is_active=False)
    RejectedDesigner.objects.create(
        username=user.username,
        email=user.email,
        reason=request.GET.get("reason", "No reason provided")
    )
    email = user.email
    username = user.username
    user.delete()

    if email:
        send_mail(
            subject="Redym Designer Account Application",
            message=(
                f"Hello {username},\n\n"
                "We’re sorry, but your application for a Redym designer account has been declined.\n"
                "If you believe this is a mistake or would like to appeal, please contact our team.\n\n"
                "Best regards,\nTeam Redym"
            ),
            from_email=settings.DEFAULT_FROM_EMAIL,
            recipient_list=[email],
            fail_silently=True,
        )

    messages.warning(request, f"Designer {username} has been rejected and recorded.")
    return redirect("pending_designers")

@login_required
@user_passes_test(lambda u: u.is_staff)
def reinstate_designer(request, designer_id):
    rejected = get_object_or_404(RejectedDesigner, id=designer_id)

    if not User.objects.filter(username=rejected.username).exists():
        user = User.objects.create_user(
            username=rejected.username,
            email=rejected.email,
            password=User.objects.make_random_password()
        )
        user.is_active = False
        user.save()
        rejected.delete()

        messages.success(request, f"Designer {user.username} has been reinstated. You can now approve them.")
    else:
        messages.error(request, f"Cannot reinstate {rejected.username}: username already exists.")

    return redirect("pending_designers")

from django.http import HttpResponse
from django.shortcuts import get_object_or_404
from reportlab.lib.pagesizes import A4
from reportlab.lib import colors
from reportlab.lib.units import inch
from reportlab.lib.styles import getSampleStyleSheet
from reportlab.platypus import (
    SimpleDocTemplate,
    Paragraph,
    Spacer,
    Image,
    Table,
    TableStyle,
    PageBreak,
)
from io import BytesIO
import os
from django.conf import settings
from .models import Collection, Look


def generate_techpack(request, slug):
    # 1️⃣ Get collection and looks
    collection = get_object_or_404(Collection, slug=slug)
    looks = collection.looks.all()

    # 2️⃣ Create PDF buffer
    buffer = BytesIO()
    doc = SimpleDocTemplate(
    buffer,
    pagesize=A4,
    topMargin=1 * inch,
    bottomMargin=0.8 * inch,
    leftMargin=0.7 * inch,
    rightMargin=0.7 * inch,
)

    styles = getSampleStyleSheet()
    story = []

    # 3️⃣ Logo path
    logo_path = os.path.join(settings.BASE_DIR, "redym_portfolio", "static", "images", "logo.png")

    # --- COVER PAGE ---
    if os.path.exists(logo_path):
        story.append(Image(logo_path, width=2.5 * inch, height=2.5 * inch))
        story.append(Spacer(1, 0.3 * inch))

    story.append(Paragraph(f"<b>{collection.name}</b>", styles["Title"]))
    story.append(Paragraph(f"Season: {collection.season or 'N/A'}", styles["Heading3"]))
    story.append(Paragraph(f"Year: {getattr(collection, 'year', 'N/A')}", styles["Normal"]))
    story.append(Paragraph(f"Total Looks: {looks.count()}", styles["Normal"]))

    if hasattr(collection, "designer") and collection.designer:
        story.append(Spacer(1, 0.2 * inch))
        story.append(Paragraph(f"<b>Designer:</b> {collection.designer}", styles["Normal"]))

    story.append(Spacer(1, 0.5 * inch))

    if getattr(collection, "cover_image", None):
        try:
            story.append(Image(collection.cover_image.path, width=5 * inch, height=5 * inch))
        except Exception:
            story.append(Paragraph("(Cover image unavailable)", styles["Italic"]))

    story.append(Spacer(1, 0.5 * inch))
    story.append(Paragraph("Generated by Redym Portfolio — AIOak Inc.", styles["Italic"]))
    story.append(PageBreak())

    # --- LOOK DETAIL PAGES ---
    for i, look in enumerate(looks, start=1):
        story.append(Paragraph(f"<b>Look {i}: {look.title or f'Look {i}'}</b>", styles["Heading2"]))
        story.append(Spacer(1, 0.2 * inch))

        if getattr(look, "image", None):
            try:
                story.append(Image(look.image.path, width=4 * inch, height=4 * inch))
            except Exception:
                story.append(Paragraph("(Image not available)", styles["Italic"]))
        story.append(Spacer(1, 0.3 * inch))

        data = [
            ["Description", getattr(look, "description", "—")],
            ["Fabric", getattr(look, "fabric", "—")],
            ["Measurements", getattr(look, "measurements", "—")],
            ["Notes", getattr(look, "notes", "—")],
        ]
        table = Table(data, colWidths=[1.5 * inch, 4.5 * inch])
        table.setStyle(TableStyle([
            ("BOX", (0,0), (-1,-1), 0.5, colors.grey),
            ("INNERGRID", (0,0), (-1,-1), 0.25, colors.lightgrey),
            ("VALIGN", (0,0), (-1,-1), "TOP"),
            ("FONTSIZE", (0,0), (-1,-1), 10),
            ("BACKGROUND", (0,0), (-1,0), colors.whitesmoke),
        ]))
        story.append(table)
        story.append(Spacer(1, 0.5 * inch))
        story.append(PageBreak())

    # --- SUMMARY PAGE ---
    story.append(Paragraph("<b>Fabric & Measurement Summary</b>", styles["Title"]))
    story.append(Spacer(1, 0.3 * inch))

    if looks.exists():
        summary_data = [["Look", "Fabric", "Swatch", "Measurements"]]

        # Fabric color mapping
        fabric_colors = {
            "cotton": colors.lightblue,
            "silk": colors.beige,
            "denim": colors.lightgrey,
            "linen": colors.whitesmoke,
            "wool": colors.azure,
            "satin": colors.mistyrose,
        }

        # Optional swatch image directory
        swatch_dir = os.path.join(settings.BASE_DIR, "redym_portfolio", "static", "swatches")

        for look in looks:
            fabric_name = (look.fabric or "—")
            # Check for a fabric swatch image
            swatch_img = None
            if fabric_name and fabric_name.strip() != "—":
                for key in fabric_colors.keys():
                    if key in fabric_name.lower():
                        candidate = os.path.join(swatch_dir, f"{key}.png")
                        if os.path.exists(candidate):
                            swatch_img = candidate
                            break

            # Prepare swatch cell
            if swatch_img:
                swatch_cell = Image(swatch_img, width=0.4 * inch, height=0.4 * inch)
            else:
                swatch_cell = "—"

            summary_data.append([
                look.title or f"Look {look.look_number}",
                fabric_name,
                swatch_cell,
                look.measurements or "—",
            ])

        summary_table = Table(summary_data, colWidths=[1.8 * inch, 2.2 * inch, 0.7 * inch, 2.3 * inch])

        # Base table style
        base_style = TableStyle([
            ("BACKGROUND", (0,0), (-1,0), colors.darkgrey),
            ("TEXTCOLOR", (0,0), (-1,0), colors.whitesmoke),
            ("BOX", (0,0), (-1,-1), 0.5, colors.grey),
            ("INNERGRID", (0,0), (-1,-1), 0.25, colors.grey),
            ("FONTSIZE", (0,0), (-1,-1), 10),
            ("VALIGN", (0,0), (-1,-1), "MIDDLE"),
        ])

        # Apply fabric background color for fabric cells
        for i, look in enumerate(looks, start=1):
            fabric = (look.fabric or "").lower()
            for key, color in fabric_colors.items():
                if key in fabric:
                    base_style.add("BACKGROUND", (1, i), (1, i), color)
                    break

        summary_table.setStyle(base_style)
        story.append(summary_table)
    else:
        story.append(Paragraph("No looks available to summarize.", styles["Normal"]))

    story.append(Spacer(1, 0.5 * inch))
    story.append(Paragraph("<i>End of Techpack</i>", styles["Italic"]))

    doc.build(
    story,
    onFirstPage=lambda canvas, doc: draw_header_footer(canvas, doc, collection),
    onLaterPages=lambda canvas, doc: draw_header_footer(canvas, doc, collection),
)

    pdf = buffer.getvalue()
    buffer.close()

    response = HttpResponse(pdf, content_type="application/pdf")
    response["Content-Disposition"] = f'attachment; filename="{collection.slug}_techpack.pdf"'
    return response

from reportlab.lib import colors
from reportlab.lib.pagesizes import A4
from reportlab.lib.units import inch

def draw_header_footer(canvas, doc, collection):
    """
    Draw header and footer for each page.
    """
    canvas.saveState()

    page_width, page_height = A4

    # --- HEADER ---
    header_y = page_height - 0.6 * inch

    # Line under header
    canvas.setStrokeColor(colors.grey)
    canvas.setLineWidth(0.5)
    canvas.line(0.7 * inch, header_y - 4, page_width - 0.7 * inch, header_y - 4)

    # Header text: Collection info
    canvas.setFont("Helvetica-Bold", 10)
    header_text = f"{collection.name} — {collection.season or 'Season'} {getattr(collection, 'year', '')}"
    canvas.setFillColor(colors.black)
    canvas.drawString(0.7 * inch, header_y + 2, header_text)

    # --- FOOTER ---
    footer_y = 0.5 * inch
    canvas.setStrokeColor(colors.grey)
    canvas.setLineWidth(0.5)
    canvas.line(0.7 * inch, footer_y + 8, page_width - 0.7 * inch, footer_y + 8)

    # Left footer: brand
    canvas.setFont("Helvetica-Bold", 9)
    canvas.drawString(0.7 * inch, footer_y - 2, "Redym Tech Pack")

    # Right footer: page number
    page_text = f"Page {doc.page}"
    canvas.setFont("Helvetica", 9)
    canvas.drawRightString(page_width - 0.7 * inch, footer_y - 2, page_text)

    canvas.restoreState()

from reportlab.lib import colors
from reportlab.lib.pagesizes import A4
from reportlab.lib.units import inch
import os
from django.conf import settings


def draw_header_footer(canvas, doc, collection):
    """
    Draw header (with logo + collection info) and footer (brand + page number)
    for each page in the Tech Pack.
    """
    canvas.saveState()
    page_width, page_height = A4

    # --- HEADER ---
    header_y = page_height - 0.6 * inch
    logo_path = os.path.join(settings.BASE_DIR, "redym_portfolio", "static", "images", "logo.png")

    # Draw logo if exists
    if os.path.exists(logo_path):
        try:
            canvas.drawImage(logo_path, 0.7 * inch, header_y - 10, width=0.5 * inch, height=0.5 * inch, mask="auto")
        except Exception:
            pass

    # Header text (collection name + season/year)
    header_text = f"{collection.name} — {collection.season or 'Season'} {getattr(collection, 'year', '')}"
    canvas.setFont("Helvetica-Bold", 10)
    canvas.setFillColor(colors.black)
    canvas.drawString(1.4 * inch, header_y + 2, header_text)

    # Thin line below header
    canvas.setStrokeColor(colors.grey)
    canvas.setLineWidth(0.5)
    canvas.line(0.7 * inch, header_y - 4, page_width - 0.7 * inch, header_y - 4)

    # --- FOOTER ---
    footer_y = 0.5 * inch
    canvas.setStrokeColor(colors.grey)
    canvas.setLineWidth(0.5)
    canvas.line(0.7 * inch, footer_y + 8, page_width - 0.7 * inch, footer_y + 8)

    # Left footer: Brand
    canvas.setFont("Helvetica-Bold", 9)
    canvas.drawString(0.7 * inch, footer_y - 2, "Redym Tech Pack")

    # Right footer: Page number
    page_text = f"Page {doc.page}"
    canvas.setFont("Helvetica", 9)
    canvas.drawRightString(page_width - 0.7 * inch, footer_y - 2, page_text)

    canvas.restoreState()

